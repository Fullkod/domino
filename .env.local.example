# Supabase (public values only: the anon key is protected by RLS)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Tasknic project key for this repo (agents only, never NEXT_PUBLIC_)
TASKNIC_API_KEY=

# Supabase CLI / MCP for this project (agents and developers only, never NEXT_PUBLIC_).
# Each developer uses their own account token: Dashboard → Account → Access Tokens.
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
